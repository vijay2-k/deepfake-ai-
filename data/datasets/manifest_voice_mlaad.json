{
  "dataset_id": "mlaad",
  "official_source": "https://github.com/DCASE-Community/MLAAD (DCASE / IEEE 2023)",
  "license": "Creative Commons Attribution-NonCommercial-ShareAlike 4.0 (CC BY-NC-SA 4.0)",
  "format": "16kHz / 24kHz FLAC audio spanning 10 languages",
  "leakage_policy": "Language-balanced speaker-independent 80/10/10 split.",
  "splits": {
    "train": {
      "bonafide_samples": 8000,
      "spoof_samples": 8000,
      "speakers_count": 150,
      "partition_strategy": "Strict speaker-independent isolation"
    },
    "validation": {
      "bonafide_samples": 1500,
      "spoof_samples": 1500,
      "speakers_count": 30
    },
    "independent_test": {
      "bonafide_samples": 2500,
      "spoof_samples": 2500,
      "speakers_count": 50,
      "evaluation_conditions": [
        "Short clips (< 1.5s speech)",
        "Standard clips (1.5s - 5.0s speech)",
        "Long recordings (> 5.0s speech)",
        "Acoustic noise (Clean SNR > 25dB, Moderate SNR 15dB, Heavy SNR 6dB)"
      ]
    }
  }
}
{
  "dataset_id": "faceforensics_plus_plus",
  "official_source": "https://github.com/ondyari/FaceForensics (ICCV 2019, Technical University of Munich)",
  "license": "Academic Non-Commercial Research Use Only",
  "format": "H.264 video frames and lossless PNG face extractions",
  "leakage_policy": "Actor/video-level separation (720 train, 140 val, 140 test videos). Frames from the same video are strictly forbidden from spanning train and test.",
  "splits": {
    "train": {
      "real_samples": 10000,
      "synthetic_samples": 10000,
      "class_ratio": "1.0 (50% real / 50% synthetic)",
      "partition_strategy": "Stratified by generator model family"
    },
    "validation": {
      "real_samples": 2000,
      "synthetic_samples": 2000,
      "class_ratio": "1.0"
    },
    "independent_test": {
      "real_samples": 3000,
      "synthetic_samples": 3000,
      "class_ratio": "1.0",
      "evaluation_conditions": [
        "Full resolution (512x512)",
        "Partial crops (128x128, 256x256)",
        "JPEG compression (Q=50, Q=75, Q=90)"
      ]
    }
  }
}
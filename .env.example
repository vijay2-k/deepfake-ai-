# GEMINI_API_KEY: Required for Google Gemini API calls.
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The local or hosted application URL.
APP_URL=http://localhost:3000

# HIVE_API_KEY: Optional Hive Detect API key (https://docs.thehive.ai/reference/ai-generated-image-and-video-detection-1).
# When provided, KRYPTX connects directly to live Hive AI detection endpoints.
# When omitted, KRYPTX runs on its built-in local Multi-Model Forensic Vision Engine.
HIVE_API_KEY=your_hive_api_key_here
HIVE_API_ENDPOINT=https://api.thehive.ai/api/v2/task/sync

# KRYPTX Administrator Initial Password
KRYPTX_ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here
